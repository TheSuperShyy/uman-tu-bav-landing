# LeadForm → Monday.com wiring.
# Set these in Vercel Project Settings → Environment Variables (production
# + preview), and in a local .env.local for `vercel dev`. Do not commit
# .env.local — it's ignored by default in Vite/Vercel projects.

# Personal API token from Monday → Avatar → Developers → My access tokens.
MONDAY_API_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJ0aWQiOjY0OTI4NjExNCwiYWFpIjoxMSwidWlkIjoxMDI0MzQwMzYsImlhZCI6IjIwMjYtMDQtMjNUMTA6NDk6MzAuMDAwWiIsInBlciI6Im1lOndyaXRlIiwiYWN0aWQiOjM0NzQzNDUwLCJyZ24iOiJldWMxIn0.t0HsdNyAZGeZOeYrRDCdCy7WrS15WOh6aynDLc4zLqs

# The numeric board ID (the long number in the board URL after /boards/).
MONDAY_BOARD_ID=

# JSON map of form field name → Monday column id. Single-line JSON.
# Example (the column ids are made-up — get yours from Monday → board → ⋯
# on a column → Customize column → Column id):
# MONDAY_COLUMN_MAP={"age":"numbers__1","birthDate":"date__1","city":"text__1","occupation":"text__2","phone":"phone__1","phoneKind":"dropdown__1","passport":"dropdown__2","email":"email__1"}
MONDAY_COLUMN_MAP={}
